<Window x:Class="DiagramApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BPMN Diagram Viewer  —  powered by Aspose.Diagram"
        Width="1280" Height="820"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

  <Window.Resources>
    <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Foreground" Value="#CFD8DC"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    BorderThickness="3,0,0,0" BorderBrush="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2A3F55"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FC3F7"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1E3348"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToolBtnStyle" TargetType="Button">
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="#F5F5F5"/>
      <Setter Property="BorderBrush" Value="#BDBDBD"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Compact variant for the alignment buttons -->
    <Style x:Key="AlignBtnStyle" TargetType="Button" BasedOn="{StaticResource ToolBtnStyle}">
      <Setter Property="Padding" Value="7,4"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MinWidth" Value="0"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ── Sidebar ─────────────────────────────────────────────────────────── -->
    <Grid Grid.Column="0" Background="#1A2B3C">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#0D1B2A" Padding="14,14,14,10">
        <StackPanel>
          <TextBlock Text="BPMN Viewer" FontSize="16" FontWeight="Bold"
                     Foreground="#4FC3F7"/>
          <TextBlock Text="via Aspose.Diagram" FontSize="10"
                     Foreground="#546E7A" Margin="0,1,0,0"/>
        </StackPanel>
      </Border>

      <TextBlock Grid.Row="1" Text="WORKFLOW FILES"
                 Foreground="#546E7A" FontSize="10" FontWeight="SemiBold"
                 Margin="14,12,0,4"/>

      <ListBox x:Name="FileListBox" Grid.Row="2"
               Background="Transparent" BorderThickness="0"
               ItemContainerStyle="{StaticResource NavItemStyle}"
               SelectionChanged="FileListBox_SelectionChanged"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11.5"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- ── Main content ────────────────────────────────────────────────────── -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- export + zoom toolbar -->
        <RowDefinition Height="Auto"/>   <!-- arrange toolbar -->
        <RowDefinition Height="*"/>      <!-- diagram canvas -->
        <RowDefinition Height="Auto"/>   <!-- status bar -->
      </Grid.RowDefinitions>

      <!-- ── Toolbar row 1: Export + Zoom ──────────────────────────────────── -->
      <Border Grid.Row="0" Background="White"
              BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
        <DockPanel Margin="8,5">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <TextBlock Text="Export:" VerticalAlignment="Center"
                       Foreground="#757575" Margin="0,0,6,0" FontSize="12"/>
            <Button x:Name="BtnExportVsdx" Content="💾 Visio (.vsdx)"
                    Style="{StaticResource ToolBtnStyle}"
                    Click="BtnExportVsdx_Click" IsEnabled="False"/>
            <Button x:Name="BtnExportPdf" Content="📄 PDF"
                    Style="{StaticResource ToolBtnStyle}"
                    Click="BtnExportPdf_Click" IsEnabled="False"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Content="Fit" Style="{StaticResource ToolBtnStyle}"
                    Click="BtnFit_Click" x:Name="BtnFit" IsEnabled="False"/>
            <TextBlock Text=" " VerticalAlignment="Center"/>
            <Button Content="−" Style="{StaticResource ToolBtnStyle}" Width="30"
                    Click="BtnZoomOut_Click"/>
            <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center"
                       Margin="6,0" FontSize="12" MinWidth="40"
                       TextAlignment="Center"/>
            <Button Content="+" Style="{StaticResource ToolBtnStyle}" Width="30"
                    Click="BtnZoomIn_Click"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ── Toolbar row 2: Arrange ─────────────────────────────────────────── -->
      <Border Grid.Row="1" Background="#FAFAFA"
              BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
        <DockPanel Margin="8,4">

          <!-- Selection info (right-docked so it doesn't push buttons) -->
          <TextBlock x:Name="LblSelection" DockPanel.Dock="Right"
                     VerticalAlignment="Center" FontSize="11"
                     Foreground="#9E9E9E" Margin="8,0,4,0"
                     Text="No selection"/>

          <!-- Align group label -->
          <TextBlock Text="Align:" VerticalAlignment="Center"
                     Foreground="#757575" FontSize="11" Margin="0,0,4,0"/>

          <!-- Align buttons -->
          <Button x:Name="BtnAlignLeft"   Content="⊣ Left"    Style="{StaticResource AlignBtnStyle}" IsEnabled="False" Click="BtnAlignLeft_Click"   ToolTip="Align left edges"/>
          <Button x:Name="BtnAlignCtrH"   Content="↔ Center"  Style="{StaticResource AlignBtnStyle}" IsEnabled="False" Click="BtnAlignCtrH_Click"   ToolTip="Center horizontally"/>
          <Button x:Name="BtnAlignRight"  Content="⊢ Right"   Style="{StaticResource AlignBtnStyle}" IsEnabled="False" Click="BtnAlignRight_Click"  ToolTip="Align right edges"/>

          <Separator Margin="4,0"/>

          <Button x:Name="BtnAlignTop"    Content="⊤ Top"     Style="{StaticResource AlignBtnStyle}" IsEnabled="False" Click="BtnAlignTop_Click"    ToolTip="Align top edges"/>
          <Button x:Name="BtnAlignMidV"   Content="↕ Middle"  Style="{StaticResource AlignBtnStyle}" IsEnabled="False" Click="BtnAlignMidV_Click"   ToolTip="Center vertically"/>
          <Button x:Name="BtnAlignBot"    Content="⊥ Bottom"  Style="{StaticResource AlignBtnStyle}" IsEnabled="False" Click="BtnAlignBot_Click"    ToolTip="Align bottom edges"/>

          <Separator Margin="4,0"/>

          <Button x:Name="BtnDistribH"    Content="↔ Distrib" Style="{StaticResource AlignBtnStyle}" IsEnabled="False" Click="BtnDistribH_Click"    ToolTip="Distribute horizontally"/>
          <Button x:Name="BtnDistribV"    Content="↕ Distrib" Style="{StaticResource AlignBtnStyle}" IsEnabled="False" Click="BtnDistribV_Click"    ToolTip="Distribute vertically"/>

          <Separator Margin="6,0"/>

          <Button x:Name="BtnAutoLayout"  Content="⟳ Auto Layout" Style="{StaticResource ToolBtnStyle}" IsEnabled="False" Click="BtnAutoLayout_Click" ToolTip="Apply left-to-right layered layout"/>

        </DockPanel>
      </Border>

      <!-- ── Diagram canvas ─────────────────────────────────────────────────── -->
      <Border Grid.Row="2" Background="#EAECEF">
        <ScrollViewer x:Name="DiagramScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="DiagramScrollViewer_PreviewMouseWheel">
          <Canvas x:Name="DiagramCanvas"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
            <Canvas.LayoutTransform>
              <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
            </Canvas.LayoutTransform>
          </Canvas>
        </ScrollViewer>
      </Border>

      <!-- ── Status bar ─────────────────────────────────────────────────────── -->
      <Border Grid.Row="3" Background="#FAFAFA"
              BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="14,4">
        <DockPanel>
          <TextBlock x:Name="StatusRight" DockPanel.Dock="Right"
                     FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusLeft"
                     FontSize="11" Foreground="#616161" VerticalAlignment="Center"
                     Text="Select a BPMN file from the list to view its workflow diagram."/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
